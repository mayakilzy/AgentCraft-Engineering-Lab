# AgentCraft Engineering Lab — PRODUCTION environment template.
#
# Copy to `.env` on the production server and fill in REAL secrets.
#
# CRITICAL: every value marked CHANGE_ME MUST be replaced with a real,
# strong, unique value before `docker compose up`. The backend's
# fail-closed validator will REFUSE TO BOOT if any are left as defaults.
#
# Generate strong passwords with:
#   openssl rand -base64 32

# ---- Application ----
APP_ENV=production
APP_NAME=AgentCraft Engineering Lab
LOG_LEVEL=INFO

# ---- Database (PostgreSQL inside compose) ----
DATABASE_URL=postgresql+psycopg2://agentcraft:CHANGE_ME_PG_PASS@postgres:5432/agentcraft
POSTGRES_USER=agentcraft
POSTGRES_PASSWORD=CHANGE_ME_PG_PASS
POSTGRES_DB=agentcraft

# ---- Sessions ----
SESSION_TTL_HOURS=24
SESSION_COOKIE_NAME=ac_guest
SESSION_COOKIE_SECURE=true

# ---- Security ----
CORS_ORIGINS=https://your-domain.example.com
RATE_LIMIT_PER_MINUTE=60

# ---- Lab runtime bounds ----
RUN_TIME_BUDGET_SECONDS=30
MAX_GRAPH_NODES=200
MAX_GRAPH_EDGES=500
MAX_OUTPUT_BYTES=262144
MAX_QUESTION_CHARS=2000

# ---- Mentor ----
MENTOR_PROVIDER=disabled

# ---- Observability (internal Docker service names) ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=agentcraft-api
PROMETHEUS_URL=http://prometheus:9090
TEMPO_URL=http://tempo:3200
GRAFANA_URL=http://grafana:3000

# ---- Neo4j ----
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_NEO4J_PASS
NEO4J_DATABASE=neo4j
GDS_LICENSED=true

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASS

# ---- NPM (Mission J-FIX-04) ----
NPM_NETWORK=agentcraft-proxy
