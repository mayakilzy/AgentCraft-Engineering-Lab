# AgentCraft Engineering Lab — environment configuration template.
# Copy to `.env` and adjust. NEVER commit real secrets.
#
# G07/T26 production overrides (per ADR-0003 Part B):
#   - APP_ENV=production
#   - SESSION_COOKIE_SECURE=true (HTTPS only)
#   - CORS_ORIGINS=https://your-production-domain
#   - POSTGRES_PASSWORD=<strong-non-default>
#   - NEO4J_PASSWORD=<strong-non-default>
#   - GRAFANA_ADMIN_PASSWORD=<strong-non-default>
#   - RATE_LIMIT_PER_MINUTE=60 (or stricter)

# ---- Application ----
APP_ENV=local                          # local | demo | production
APP_NAME=AgentCraft Engineering Lab
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR

# ---- Database ----
# Default to SQLite for local dev/tests; switch to PostgreSQL for Compose/prod.
DATABASE_URL=sqlite:///./agentcraft.db
# PostgreSQL example (used by docker-compose core profile):
# DATABASE_URL=postgresql+psycopg2://agentcraft:agentcraft@postgres:5432/agentcraft
POSTGRES_USER=agentcraft
POSTGRES_PASSWORD=changeme              # MUST override in production
POSTGRES_DB=agentcraft

# ---- Sessions ----
SESSION_TTL_HOURS=24
SESSION_COOKIE_NAME=ac_guest
SESSION_COOKIE_SECURE=false            # MUST be true in production (HTTPS only)

# ---- Security ----
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# In production: CORS_ORIGINS=https://your-production-domain
RATE_LIMIT_PER_MINUTE=60               # enforced on POST /experiments/{id}/runs

# ---- Lab runtime bounds ----
RUN_TIME_BUDGET_SECONDS=30
MAX_GRAPH_NODES=200
MAX_GRAPH_EDGES=500
MAX_OUTPUT_BYTES=262144                # 256 KiB
MAX_QUESTION_CHARS=2000

# ---- Mentor (Engineering Tutor) ----
# `disabled` = deterministic rule-based fallback (no external calls)
MENTOR_PROVIDER=disabled
# MENTOR_OPENAI_API_KEY=               # server-side only; never committed
# MENTOR_OPENAI_MODEL=gpt-4o-mini

# ---- Observability (wired in G04; safe to leave unset for G01-G03) ----
OTEL_EXPORTER_OTLP_ENDPOINT=           # e.g. http://otel-collector:4318
OTEL_SERVICE_NAME=agentcraft-api
PROMETHEUS_URL=                        # e.g. http://prometheus:9090
TEMPO_URL=                             # e.g. http://tempo:3200
GRAFANA_URL=                           # e.g. http://grafana:3000

# ---- Neo4j (wired in G03; safe to leave unset for G01-G02) ----
NEO4J_URI=                             # e.g. bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=                        # MUST override in production
NEO4J_DATABASE=neo4j
GDS_LICENSED=false                     # true if Neo4j GDS plugin available

# ---- Grafana (used by docker-compose observability profile) ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme        # MUST override in production
