# AgentCraft Engineering Lab — environment configuration template.
#
# Copy to `.env` and fill in real values. NEVER commit real secrets.
#
# For Nginx Proxy Manager (NPM) deployments, set:
#   APP_ENV=production
#   SESSION_COOKIE_SECURE=true
#   CORS_ORIGINS=https://your-domain.example.com
#   POSTGRES_PASSWORD=<strong>
#   NEO4J_PASSWORD=<strong>
#   GRAFANA_ADMIN_PASSWORD=<strong>

# ---- Application ----
APP_ENV=local                          # local | demo | production
APP_NAME=AgentCraft Engineering Lab
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR

# ---- Database ----
DATABASE_URL=sqlite:///./agentcraft.db
# PostgreSQL (used by docker-compose core profile):
# DATABASE_URL=postgresql+psycopg2://agentcraft:agentcraft@postgres:5432/agentcraft
POSTGRES_USER=agentcraft
POSTGRES_PASSWORD=changeme              # MUST override in production
POSTGRES_DB=agentcraft

# ---- Sessions ----
SESSION_TTL_HOURS=24
SESSION_COOKIE_NAME=ac_guest
SESSION_COOKIE_SECURE=false            # MUST be true in production (HTTPS only)

# ---- Security ----
# CORS_ORIGINS accepts CSV (default) or JSON array form. Both are valid:
#   CSV:  CORS_ORIGINS=http://localhost:5173,http://localhost:8080
#   JSON: CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
RATE_LIMIT_PER_MINUTE=60

# ---- Lab runtime bounds ----
RUN_TIME_BUDGET_SECONDS=30
MAX_GRAPH_NODES=200
MAX_GRAPH_EDGES=500
MAX_OUTPUT_BYTES=262144
MAX_QUESTION_CHARS=2000

# ---- Mentor ----
MENTOR_PROVIDER=disabled

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agentcraft-api
PROMETHEUS_URL=
TEMPO_URL=
GRAFANA_URL=

# ---- Neo4j ----
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
GDS_LICENSED=false

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# ---- NPM (Mission J-FIX-04) ----
# Name of the external Docker network NPM uses to reach the app.
# Create it once: docker network create agentcraft-proxy
NPM_NETWORK=agentcraft-proxy
